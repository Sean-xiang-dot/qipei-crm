ENTERPRISE_TRAINING_MCP_URL=https://enterprise-training-mcp.coolify.eeo-inc.com

# 可选：DeepSeek 拜访分析。不配置时使用本地规则分析，页面会明确标记来源。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：其他兼容结构化 JSON 输出的通用 AI 分析服务。
AI_ANALYSIS_URL=
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_MODEL=

# 企培 CRM 中用于客户跟进/拜访记录的 activityrecord entityType。
CRM_DEFAULT_ACTIVITY_ENTITY_TYPE=11010011100002

# 页面级数据范围。填写销售易 userId，逗号分隔；不在名单中的用户只能查看本人数据。
# 主管可以切换“我的/我的团队”，企培负责人还可以查看企培全量。
CRM_MANAGER_USER_IDS=
CRM_DIRECTOR_USER_IDS=
